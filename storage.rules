rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidAudioType() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isValidVideoType() {
      return request.resource.contentType.matches('video/.*');
    }

    function isUnderSizeLimit(limitMB) {
      return request.resource.size <= limitMB * 1024 * 1024;
    }

    // ─── User Avatars ─────────────────────────────────────────────────────────
    match /users/{userId}/avatar/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(userId)
        && isValidImageType()
        && isUnderSizeLimit(5);
    }

    // ─── Story Media ─────────────────────────────────────────────────────────
    match /stories/{storyId}/images/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
        && isValidImageType()
        && isUnderSizeLimit(10);
      allow delete: if isAuthenticated() || isAdmin();
    }

    match /stories/{storyId}/audio/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
        && isValidAudioType()
        && isUnderSizeLimit(100);
      allow delete: if isAuthenticated() || isAdmin();
    }

    match /stories/{storyId}/video/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
        && isValidVideoType()
        && isUnderSizeLimit(500);
      allow delete: if isAuthenticated() || isAdmin();
    }

    // ─── Thumbnails (read-only from client) ───────────────────────────────────
    match /thumbnails/{path=**} {
      allow read: if true;
      allow write: if false; // Generated by Cloud Functions only
    }

    // ─── District Assets ──────────────────────────────────────────────────────
    match /districts/{districtId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
